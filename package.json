{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "transit:build": "node scripts/build-tokyo-transit.mjs",
    "test:requirement-verdict": "tsx scripts/test-requirement-verdict.ts",
    "test:heatmap-transit": "tsx scripts/test-heatmap-transit.ts",
    "test:athome-rent": "tsx scripts/test-athome-rent-snapshot.ts",
    "test:buy-market": "tsx scripts/test-buy-market.ts",
    "test:market-sources": "tsx scripts/test-market-data-sources.ts",
    "test:admin-metrics": "tsx scripts/test-admin-metrics.ts",
    "test:threads-search": "tsx scripts/test-threads-search.ts",
    "threads:sync-text": "node scripts/build-threads-search-index.mjs",
    "threads:sync-images": "tsx scripts/sync-thread-images.ts",
    "threads:sync": "npm run threads:sync-text && npm run threads:sync-images",
    "data:review": "node scripts/review-market-sources.mjs && node scripts/review-rent-data.mjs",
    "data:review:rent": "node scripts/review-rent-data.mjs",
    "data:update:athome": "tsx scripts/update-athome-rent-data.ts",
    "data:update:mlit-buy": "tsx scripts/update-mlit-buy-data.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
