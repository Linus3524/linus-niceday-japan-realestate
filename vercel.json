{
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/rent-analysis",
      "destination": "/api/rent-analysis"
    },
    {
      "source": "/api/visitor-count",
      "destination": "/api/visitor-count"
    },
    {
      "source": "/api/market-lookup",
      "destination": "/api/market-lookup"
    },
    {
      "source": "/api/usage-stats",
      "destination": "/api/usage-stats"
    },
    {
      "source": "/api/vercel-analytics",
      "destination": "/api/vercel-analytics"
    },
    {
      "source": "/api/track-view",
      "destination": "/api/track-view"
    },
    {
      "source": "/api/analyze-listing",
      "destination": "/api/analyze-listing"
    },
    {
      "source": "/api/listing-share",
      "destination": "/api/listing-share"
    },
    {
      "source": "/api/listing-location",
      "destination": "/api/listing-location"
    },
    {
      "source": "/quiz/",
      "destination": "https://tokyo-living-persona.vercel.app/"
    },
    {
      "source": "/quiz/:path*",
      "destination": "https://tokyo-living-persona.vercel.app/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:file((?!quiz(?:/|$)|api/|assets/).*\\.[a-zA-Z0-9]+)",
      "has": [
        {
          "type": "host",
          "value": "linus-niceday-japan-realestate.vercel.app"
        }
      ],
      "destination": "https://linusniceday.com/:file",
      "permanent": true
    },
    {
      "source": "/:path((?!quiz(?:/|$)|api/|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "linus-niceday-japan-realestate.vercel.app"
        }
      ],
      "destination": "/quiz/?next=/:path",
      "permanent": false
    },
    {
      "source": "/quiz",
      "destination": "/quiz/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
