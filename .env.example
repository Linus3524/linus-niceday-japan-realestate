# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional identification header required by Transitous. Include a contact URL or email before public release.
TRANSITOUS_USER_AGENT="LINUS-NiceDay/1.0 (https://github.com/Linus3524/linus-niceday-japan-realestate)"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional but required for the persistent visitor counter and shared API rate limiting.
UPSTASH_REDIS_REST_URL="https://YOUR_REDIS_INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# Global hourly cap for listing analysis (cost control). Default 100 requests/hour.
# Adjust based on budget: e.g., 100-150 for limited budget, 300 for higher tolerance.
LISTING_CHECK_GLOBAL_HOURLY_CAP=100

# 找房問卷（/find-home）與後台客戶需求，說明見 docs/LEADS_ADMIN.md。
# 客戶資料庫（選填）。線上沒設時沿用上面統計的 UPSTASH_REDIS_REST_*。
# 本機請不要設定，留空會用記憶體，避免測試資料寫進正式資料庫。
LEADS_REDIS_REST_URL="https://YOUR_LEADS_INSTANCE.upstash.io"
LEADS_REDIS_REST_TOKEN="YOUR_LEADS_REDIS_TOKEN"
# 後台「客戶需求」的密碼（選填；線上沒設時沿用 ANALYTICS_TOKEN）
LEADS_ADMIN_TOKEN="CHOOSE_A_LONG_RANDOM_PASSWORD"
# 新客通知信（Resend）。免費版只能寄給註冊 Resend 的那個信箱
RESEND_API_KEY="re_xxx"
LEADS_NOTIFY_TO="the-email-you-registered-resend-with@example.com"
# Vercel Cron 驗證（選填；沒設時只接受 Vercel Cron 請求、每小時最多一次）
CRON_SECRET="CHOOSE_A_LONG_RANDOM_SECRET"
